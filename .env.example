# ─────────────────────────────────────────────────────────────────────────────
# projet-mem — Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs
# ⚠️  Ne JAMAIS commiter le fichier .env
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Base de données PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=memoir
POSTGRES_PASSWORD=memoir_secret
POSTGRES_DB=projet_mem
DATABASE_URL=postgresql://memoir:memoir_secret@localhost:5432/projet_mem

# ─── Authentification ────────────────────────────────────────────────────────
# Génère avec: openssl rand -base64 64
JWT_SECRET=change_this_jwt_secret_in_production
JWT_EXPIRES_IN=7d

# ─── LightRAG (recherche intelligente dans les entrées memoir) ───────────────
LIGHTRAG_URL=http://localhost:9621
LIGHTRAG_API_KEY=changeme_lightrag

# Modèle LLM utilisé par LightRAG (Ollama — gratuit et local)
LIGHTRAG_LLM_MODEL=llama3.2
LIGHTRAG_EMBED_MODEL=nomic-embed-text

# ─── Optionnel : si tu préfères OpenAI à Ollama ──────────────────────────────
# LLM_BINDING=openai
# OPENAI_API_KEY=sk-...
# LIGHTRAG_LLM_MODEL=gpt-4o-mini

# ─── Email (notifications optionnelles) ──────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=ton@email.com
# SMTP_PASS=ton_mot_de_passe_app
# EMAIL_FROM=Projet Memoir <ton@email.com>
